# Python AI service
GOOGLE_API_KEY=replace-with-your-key
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_SECONDS=40

# Node server
HOST=127.0.0.1
PORT=3000
AI_SERVER_URL=http://127.0.0.1:8000/analyze-query-gemini
AI_TIMEOUT_MS=45000

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=MyCompany
DB_USER=postgres
DB_PASSWORD=replace-with-your-password

# Log monitoring
POSTGRES_VERSION=18
PG_LOG_DIRECTORY=C:\Program Files\PostgreSQL\18\data\log
SLOW_QUERY_THRESHOLD_MS=1000
LOG_POLL_INTERVAL_MS=2000
# Leave false to avoid analyzing an entire historical log on startup.
PROCESS_EXISTING_LOGS=false
